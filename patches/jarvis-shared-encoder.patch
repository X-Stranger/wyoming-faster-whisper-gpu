diff --git a/tests/test_jarvis_encoder.py b/tests/test_jarvis_encoder.py
new file mode 100644
index 0000000..1b14386
--- /dev/null
+++ b/tests/test_jarvis_encoder.py
@@ -0,0 +1,155 @@
+"""No GPU or model downloads:one model,parallel wake/STT,strict bounded RPC."""
+
+import asyncio
+import threading
+from pathlib import Path
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+from wyoming_faster_whisper import faster_whisper_handler as handler
+from wyoming_faster_whisper.jarvis_encoder import (
+    CROP_BYTES,
+    EncoderServer,
+    Profile,
+    SharedEncoder,
+    SttGate,
+    read_header,
+    write_message,
+)
+
+PROFILE = Path(__file__).resolve().parents[1] / "wyoming_faster_whisper/jarvis-profile.json"
+
+
+class Storage:
+    def to_device(self, device):
+        return np.arange(1500 * 1280, dtype=np.float32).reshape(1, 1500, 1280)
+
+
+class Extractor:
+    def __call__(self, pcm):
+        return np.zeros((128, 351), np.float32)
+
+
+class Model:
+    def __init__(self):
+        self.feature_extractor = Extractor()
+        self.model = SimpleNamespace(device="cuda", compute_type="float16")
+        self.started = threading.Event()
+        self.finish = threading.Event()
+
+    def encode(self, features):
+        return Storage()
+
+    def transcribe(self, *args, **kwargs):
+        def segments():
+            self.started.set()
+            assert self.finish.wait(3)
+            yield SimpleNamespace(text="свет включён")
+
+        return segments(), None
+
+
+def test_one_constructor_and_shared_object_while_STT_is_busy(monkeypatch):
+    calls = []
+    model = Model()
+
+    def construct(*args, **kwargs):
+        calls.append(kwargs)
+        return model
+
+    monkeypatch.setattr(handler.faster_whisper, "WhisperModel", construct)
+    transcriber = handler.FasterWhisperTranscriber(
+        "cached", "/data", device="cuda", compute_type="float16", num_workers=2
+    )
+    transcriber.jarvis_stt_gate = SttGate()
+    encoder = SharedEncoder(transcriber.model, Profile(PROFILE))
+    assert encoder.model is transcriber.model
+    assert len(calls) == 1 and calls[0]["num_workers"] == 2
+    assert encoder.feature_extractor is not model.feature_extractor
+
+    async def scenario():
+        stt = asyncio.create_task(asyncio.to_thread(transcriber.transcribe, "dummy.wav", "ru"))
+        try:
+            assert await asyncio.to_thread(model.started.wait, 1)
+            async with asyncio.timeout(0.5):
+                features = await asyncio.to_thread(encoder.encode, bytes(CROP_BYTES))
+            assert not stt.done() and features.shape == (9, 5120)
+        finally:
+            model.finish.set()
+            assert await stt == "свет включён"
+
+    asyncio.run(scenario())
+
+
+def test_real_RPC_serves_encode_and_health_and_rejects_profile():
+    async def scenario():
+        profile = Profile(PROFILE)
+        service = EncoderServer(profile, SharedEncoder(Model(), profile), max_pending=1)
+        server = await asyncio.start_server(service.handle, "127.0.0.1", 0)
+
+        async def request(op, identity=profile.digest):
+            reader, writer = await asyncio.open_connection(*server.sockets[0].getsockname()[:2])
+            try:
+                pcm = bytes(CROP_BYTES) if op == "encode" else b""
+                await write_message(
+                    writer,
+                    {
+                        "op": op,
+                        "request_id": "test",
+                        "profile_sha256": identity,
+                        "payload_bytes": len(pcm),
+                    },
+                    pcm,
+                )
+                header = await read_header(reader)
+                data = await reader.readexactly(header["payload_bytes"])
+                return header, data
+            finally:
+                writer.close()
+                await writer.wait_closed()
+
+        try:
+            header, data = await request("encode")
+            assert header["ok"] and len(data) == 9 * 5120 * 4
+            assert (await request("health"))[0]["ok"]
+            assert not (await request("encode", "wrong"))[0]["ok"]
+        finally:
+            server.close()
+            await server.wait_closed()
+
+    asyncio.run(scenario())
+
+
+def test_STT_gate_bounds_waiters_without_serializing_encoder():
+    gate = SttGate()
+    release = threading.Event()
+    entered = threading.Event()
+
+    def block():
+        entered.set()
+        assert release.wait(2)
+
+    first = threading.Thread(target=lambda: gate.run(block))
+    first.start()
+    assert entered.wait(1)
+    assert gate.admission.acquire(blocking=False)  # One waiting place.
+    try:
+        with pytest.raises(RuntimeError, match="full"):
+            gate.run(lambda: None)
+        assert SharedEncoder(Model(), Profile(PROFILE)).encode(bytes(CROP_BYTES)).shape == (9, 5120)
+    finally:
+        gate.admission.release()
+        release.set()
+        first.join()
+
+
+def test_profile_rejects_wrong_versions_and_weights(tmp_path, monkeypatch):
+    p = Profile(PROFILE)
+    monkeypatch.setattr("importlib.metadata.version", lambda k: "wrong")
+    with pytest.raises(ValueError, match="versions"):
+        p.validate_backend(tmp_path)
+    monkeypatch.setattr("importlib.metadata.version", lambda k: p.data["gpu_versions"][k])
+    (tmp_path / "model.bin").write_bytes(b"incorrect weights")
+    with pytest.raises(ValueError, match="weights"):
+        p.validate_backend(tmp_path)
