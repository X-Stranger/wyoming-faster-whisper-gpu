diff --git a/wyoming_faster_whisper/jarvis_encoder.py b/wyoming_faster_whisper/jarvis_encoder.py
new file mode 100644
index 0000000..e1b51c4
--- /dev/null
+++ b/wyoming_faster_whisper/jarvis_encoder.py
@@ -0,0 +1,283 @@
+"""Opt-in Jarvis encoder RPC sharing the resident STT model and its weights.
+
+Two CT2 workers share weights on one GPU;at most one STT and one encoder inference
+run concurrently. Encoder admission is independent of STT occupancy.
+"""
+
+import asyncio
+import contextlib
+import copy
+import hashlib
+import importlib.metadata
+import json
+import logging
+import re
+import threading
+import time
+from pathlib import Path
+from urllib.parse import urlsplit
+
+import numpy as np
+
+CROP_BYTES = 112000
+FEATURE_BYTES = 9 * 5120 * 4
+LAYOUT = "temporal-9x4x1280-prefix5-v1"
+LOGGER = logging.getLogger(__name__)
+
+
+def log(logger, event, **fields):
+    logger.info("%s %s", event, fields)
+
+
+class Profile:
+    def __init__(self, path):
+        raw = Path(path).read_bytes()
+        self.digest = hashlib.sha256(raw).hexdigest()
+        self.data = json.loads(raw)
+        if (
+            self.data.get("feature_layout") != LAYOUT
+            or self.data.get("handoff") != "adapter-buffered-stt-v1"
+        ):
+            raise ValueError("unsupported Jarvis profile")
+
+    def validate_backend(self, directory):
+        versions = {k: importlib.metadata.version(k) for k in self.data["gpu_versions"]}
+        if versions != self.data["gpu_versions"]:
+            raise ValueError("Jarvis GPU library versions differ from the validated backend")
+        with (Path(directory) / "model.bin").open("rb") as f:
+            digest = hashlib.file_digest(f, "sha256").hexdigest()
+        if digest != self.data["encoder_sha256"]:
+            raise ValueError("Jarvis requires the validated full large-v3 weights")
+
+
+class SttGate:
+    """One active and one waiting STT call leave the other CT2 worker for wake."""
+
+    def __init__(self):
+        self.admission = threading.BoundedSemaphore(2)
+        self.active = threading.Lock()
+
+    def run(self, function, *args, **kwargs):
+        if not self.admission.acquire(blocking=False):
+            raise RuntimeError("STT queue full")
+        acquired = False
+        try:
+            acquired = self.active.acquire(timeout=3)
+            if not acquired:
+                raise RuntimeError("STT queue deadline exceeded")
+            return function(*args, **kwargs)
+        finally:
+            if acquired:
+                self.active.release()
+            self.admission.release()
+
+
+class SharedEncoder:
+    def __init__(self, model, profile):
+        # Reuse the exact resident WhisperModel;never construct another model.
+        self.model = model
+        self.profile = profile
+        self.feature_extractor = copy.deepcopy(model.feature_extractor)
+
+    def encode(self, pcm):
+        import ctranslate2
+        from faster_whisper.audio import pad_or_trim
+
+        if len(pcm) != CROP_BYTES:
+            raise ValueError("encoder requires exactly3.5s PCM16/16k")
+        audio = np.frombuffer(pcm, "<i2").astype(np.float32) / 32768
+        storage = self.model.encode(pad_or_trim(self.feature_extractor(audio)))
+        hidden = np.asarray(storage.to_device(ctranslate2.Device.cpu), dtype=np.float32)
+        if hidden.shape != (1, 1500, 1280):
+            raise ValueError("unexpected encoder dimensions")
+        times = np.arange(1500) * 0.02
+        values = []
+        for shift in self.profile.data["pool_shifts_s"]:
+            end = 2.5 + 0.56 + shift
+            part = hidden[0, (times > end - 1.28 + 1e-8) & (times <= end + 1e-8)]
+            if len(part) != 64:
+                raise ValueError("unexpected encoder temporal layout")
+            values.append(np.concatenate([np.mean(b, axis=0) for b in np.array_split(part, 4)]))
+        return np.asarray(values, dtype="<f4")
+
+
+HEADER_LIMIT = 8192
+
+
+def endpoint(uri: str) -> tuple[str, int]:
+    value = urlsplit(uri)
+    if (
+        value.scheme != "tcp"
+        or not value.hostname
+        or not value.port
+        or value.path
+        or value.query
+        or value.fragment
+        or value.username
+        or value.password
+    ):
+        raise ValueError("encoder URI must be tcp://host:port")
+    return value.hostname, value.port
+
+
+async def read_header(reader: asyncio.StreamReader) -> dict:
+    line = await reader.readline()
+    if not line or len(line) > HEADER_LIMIT:
+        raise ValueError("missing or oversized encoder header")
+    value = json.loads(line)
+    if not isinstance(value, dict) or value.get("protocol") != 1:
+        raise ValueError("unsupported encoder protocol")
+    return value
+
+
+async def write_message(writer: asyncio.StreamWriter, header: dict, payload: bytes = b""):
+    line = json.dumps({"protocol": 1, **header}, allow_nan=False).encode() + b"\n"
+    if len(line) > HEADER_LIMIT:
+        raise ValueError("oversized encoder header")
+    writer.write(line)
+    if payload:
+        writer.write(payload)
+    await writer.drain()
+
+
+async def close_writer(writer: asyncio.StreamWriter):
+    writer.close()
+    with contextlib.suppress(OSError, asyncio.TimeoutError):
+        await asyncio.wait_for(writer.wait_closed(), timeout=0.5)
+
+
+class EncoderServer:
+    def __init__(self, profile: Profile, encoder, max_pending: int = 2):
+        self.profile, self.encoder = profile, encoder
+        self.max_pending, self.pending = max_pending, 0
+        self.lock = asyncio.Lock()
+
+    def identity(self, request_id: str) -> dict:
+        return {
+            "ok": True,
+            "request_id": request_id,
+            "profile_sha256": self.profile.digest,
+            "encoder_sha256": self.profile.data["encoder_sha256"],
+        }
+
+    async def handle(self, reader, writer) -> None:
+        reserved = False
+        request_id = "invalid"
+        try:
+            async with asyncio.timeout(1):
+                request = await read_header(reader)
+            request_id = request.get("request_id", "")
+            if not isinstance(request_id, str) or not re.fullmatch(
+                r"[A-Za-z0-9_-]{1,80}", request_id
+            ):
+                raise ValueError("invalid request identity")
+            if request.get("profile_sha256") != self.profile.digest:
+                raise ValueError("profile identity differs")
+            if request.get("op") == "health":
+                await write_message(writer, self.identity(request_id) | {"payload_bytes": 0})
+                return
+            if request.get("op") != "encode" or request.get("payload_bytes") != CROP_BYTES:
+                raise ValueError("invalid encoder request")
+            if self.pending >= self.max_pending:
+                raise ValueError("encoder queue is full")
+            self.pending += 1
+            reserved = True
+            async with asyncio.timeout(0.5):
+                pcm = await reader.readexactly(CROP_BYTES)
+            before = time.monotonic()
+            async with self.lock:
+                # Keep the lock until the native worker actually finishes on cancellation.
+                task = asyncio.create_task(asyncio.to_thread(self.encoder.encode, pcm))
+                try:
+                    features = await asyncio.shield(task)
+                except asyncio.CancelledError:
+                    await task
+                    raise
+            features = np.asarray(features, dtype="<f4")
+            if features.shape != (9, 5120) or not np.isfinite(features).all():
+                raise ValueError("encoder produced invalid features")
+            payload = features.tobytes()
+            assert len(payload) == FEATURE_BYTES
+            elapsed = (time.monotonic() - before) * 1000
+            await write_message(
+                writer,
+                self.identity(request_id)
+                | {
+                    "layout": LAYOUT,
+                    "payload_bytes": len(payload),
+                    "compute_ms": elapsed,
+                },
+                payload,
+            )
+            log(LOGGER, "encoded", request=request_id, elapsed_ms=round(elapsed, 2))
+        except (ValueError, OSError, asyncio.IncompleteReadError, TimeoutError) as error:
+            try:
+                await write_message(
+                    writer,
+                    {
+                        "ok": False,
+                        "request_id": request_id,
+                        "error": str(error),
+                        "payload_bytes": 0,
+                    },
+                )
+            except OSError:
+                pass
+            log(LOGGER, "encode_rejected", error=str(error), request=request_id)
+        except Exception:
+            LOGGER.exception("encoder_failure")
+        finally:
+            if reserved:
+                self.pending -= 1
+            await close_writer(writer)
+
+
+async def start(transcriber, profile, uri):
+    from .faster_whisper_handler import FasterWhisperTranscriber
+
+    if not isinstance(transcriber, FasterWhisperTranscriber):
+        raise ValueError("Jarvis requires faster-whisper")
+    if (
+        transcriber.model.model.device != "cuda"
+        or transcriber.model.model.compute_type != "float16"
+    ):
+        raise ValueError("Jarvis requires CUDA float16")
+    transcriber.jarvis_stt_gate = SttGate()
+    encoder = SharedEncoder(transcriber.model, profile)
+    for _ in range(3):
+        await asyncio.to_thread(encoder.encode, bytes(CROP_BYTES))
+    service = EncoderServer(profile, encoder, max_pending=1)
+    server = await asyncio.start_server(service.handle, *endpoint(uri), limit=HEADER_LIMIT)
+    LOGGER.info(
+        "Jarvis encoder ready:profile=%s shared_model_id=%s workers=2",
+        profile.digest,
+        id(transcriber.model),
+    )
+    return server
+
+
+async def check_health(uri):
+    from .health_check import check
+
+    profile = Profile(Path(__file__).with_name("jarvis-profile.json"))
+    async with asyncio.timeout(2):
+        await check("tcp://127.0.0.1:10300")
+        reader, writer = await asyncio.open_connection(*endpoint(uri), limit=HEADER_LIMIT)
+        try:
+            await write_message(writer, {"op": "health", "request_id": "health",
+                                        "profile_sha256": profile.digest})
+            response = await read_header(reader)
+            if (not response.get("ok") or response.get("profile_sha256") != profile.digest
+                    or response.get("encoder_sha256") != profile.data["encoder_sha256"]
+                    or response.get("payload_bytes") != 0):
+                raise ValueError("incompatible shared encoder health")
+        finally:
+            await close_writer(writer)
+
+
+if __name__ == "__main__":
+    import argparse
+
+    parser = argparse.ArgumentParser(description="Health check, no inference or model load")
+    parser.add_argument("--check", required=True, help="tcp://127.0.0.1:10500")
+    asyncio.run(check_health(parser.parse_args().check))
